# Appwrite backend
# Copy this file to `.env` and fill in your values.

# Canonical production origin used by the build-time sitemap and route shells.
SITE_URL=https://davidowusu.org
# Client-side metadata must use the same origin.
VITE_SITE_URL=https://davidowusu.org

# --- Client (Vite) — required ---
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

# --- Client — optional (defaults shown, must match the setup script) ---
# VITE_APPWRITE_DATABASE_ID=main
# VITE_APPWRITE_SITE_CONTENT_COLLECTION_ID=site_content
# VITE_APPWRITE_SITE_CONTENT_DOC_ID=main
# VITE_APPWRITE_EVENTS_COLLECTION_ID=events
# VITE_APPWRITE_BLOG_COLLECTION_ID=blog
# VITE_APPWRITE_SUBMISSIONS_COLLECTION_ID=submissions
# VITE_APPWRITE_BUCKET_ID=media

# --- Server only: used by `npm run setup:appwrite` (NEVER expose in client) ---
# Create an API key in the Appwrite console with Databases + Storage scopes.
APPWRITE_API_KEY=
# Optional: seed an admin login during setup
ADMIN_EMAIL=
ADMIN_PASSWORD=
